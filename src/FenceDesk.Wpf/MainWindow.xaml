<Window x:Class="FenceDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=" "
        Width="320"
        SizeToContent="Height"
        MinWidth="280"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#121C2C"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style TargetType="Button" x:Key="PanelBtn">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#203048" />
            <Setter Property="Foreground" Value="#DCE6F5" />
            <Setter Property="BorderBrush" Value="#3C5A82" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionLabel">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7A8BA8" />
            <Setter Property="Margin" Value="2,12,0,6" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="16">
        <TextBlock Text="FenceDesk"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#D2DCEB"
                   Margin="0,0,0,4" />

        <TextBlock Text="Visibility" Style="{StaticResource SectionLabel}" Margin="2,8,0,6" />
        <Button Content="Show fences" Style="{StaticResource PanelBtn}" Click="BtnFront_Click" />
        <Button Content="Hide fences" Style="{StaticResource PanelBtn}" Click="BtnHide_Click" />

        <TextBlock Text="Fences" Style="{StaticResource SectionLabel}" />
        <Button Content="New fence" Style="{StaticResource PanelBtn}" Click="BtnNew_Click" />

        <TextBlock Text="Appearance" Style="{StaticResource SectionLabel}" />
        <Button Content="Appearance…" Style="{StaticResource PanelBtn}" Click="BtnColorAll_Click" />
        <Button Content="Reset colors" Style="{StaticResource PanelBtn}" Click="BtnReset_Click" />

        <Button Content="Exit"
                Margin="0,14,0,0"
                Padding="12,9"
                HorizontalContentAlignment="Left"
                Click="BtnExit_Click"
                Background="#5A2832"
                Foreground="#FFDCDC"
                BorderBrush="#8C4650" />
    </StackPanel>
</Window>
