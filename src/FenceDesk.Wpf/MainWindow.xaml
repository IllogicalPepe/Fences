<Window x:Class="FenceDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=" "
        Width="360"
        SizeToContent="Height"
        MinWidth="300"
        MinHeight="280"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#121C2C"
        ResizeMode="CanMinimize">
    <StackPanel Margin="16">
        <TextBlock Text="FenceDesk"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#D2DCEB"
                   Margin="0,0,0,14" />

        <Button x:Name="BtnShow"
                Content="Show fences"
                Margin="0,0,0,8"
                Padding="10,8"
                HorizontalContentAlignment="Left"
                Click="BtnShow_Click"
                Background="#203048"
                Foreground="#DCE6F5"
                BorderBrush="#3C5A82" />
        <Button x:Name="BtnHide"
                Content="Hide fences"
                Margin="0,0,0,8"
                Padding="10,8"
                HorizontalContentAlignment="Left"
                Click="BtnHide_Click"
                Background="#203048"
                Foreground="#DCE6F5"
                BorderBrush="#3C5A82" />
        <Button x:Name="BtnFront"
                Content="Bring fences to front"
                Margin="0,0,0,8"
                Padding="10,8"
                HorizontalContentAlignment="Left"
                Click="BtnFront_Click"
                Background="#203048"
                Foreground="#DCE6F5"
                BorderBrush="#3C5A82" />
        <Button x:Name="BtnNew"
                Content="New fence"
                Margin="0,0,0,8"
                Padding="10,8"
                HorizontalContentAlignment="Left"
                Click="BtnNew_Click"
                Background="#203048"
                Foreground="#DCE6F5"
                BorderBrush="#3C5A82" />
        <Button x:Name="BtnColorAll"
                Content="Background color (all fences)..."
                Margin="0,0,0,8"
                Padding="10,8"
                HorizontalContentAlignment="Left"
                Click="BtnColorAll_Click"
                Background="#203048"
                Foreground="#DCE6F5"
                BorderBrush="#3C5A82" />
        <Button x:Name="BtnReset"
                Content="Reset all fence colors (bg + text)"
                Margin="0,0,0,8"
                Padding="10,8"
                HorizontalContentAlignment="Left"
                Click="BtnReset_Click"
                Background="#203048"
                Foreground="#DCE6F5"
                BorderBrush="#3C5A82" />
        <Button x:Name="BtnExit"
                Content="Exit FenceDesk (close completely)"
                Margin="0,8,0,0"
                Padding="10,8"
                HorizontalContentAlignment="Left"
                Click="BtnExit_Click"
                Background="#5A2832"
                Foreground="#FFDCDC"
                BorderBrush="#8C4650" />
    </StackPanel>
</Window>
