<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="FenceDesk.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title=" ">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="16" Background="#121C2C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#D2DCEB"
                Text="FenceDesk" />
            <TextBlock
                Margin="0,2,0,0"
                FontSize="11"
                Foreground="#8C9BAF"
                Text="Desktop fence organizer (WinUI 3)" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <Button
                x:Name="BtnShow"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="BtnShow_Click"
                Content="Show fences"
                Padding="10,8" />
            <Button
                x:Name="BtnHide"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="BtnHide_Click"
                Content="Hide fences"
                Padding="10,8" />
            <Button
                x:Name="BtnFront"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="BtnFront_Click"
                Content="Bring fences to front"
                Padding="10,8" />
            <Button
                x:Name="BtnNew"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="BtnNew_Click"
                Content="New fence"
                Padding="10,8" />
            <Button
                x:Name="BtnColorAll"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="BtnColorAll_Click"
                Content="Background color (all fences)..."
                Padding="10,8" />
            <Button
                x:Name="BtnResetColors"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Click="BtnResetColors_Click"
                Content="Reset all fence colors"
                Padding="10,8" />
            <Button
                x:Name="BtnExit"
                Margin="0,8,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Background="#5A2832"
                Click="BtnExit_Click"
                Content="Exit FenceDesk (close completely)"
                Foreground="#FFDCDC"
                Padding="10,8" />
        </StackPanel>

        <TextBlock
            Grid.Row="2"
            Margin="0,12,0,0"
            FontSize="10"
            Foreground="#78879B"
            TextWrapping="Wrap"
            Text="This panel stays out of Alt+Tab. Close it to hide (app keeps running) or choose Exit to quit. Left-click the tray icon to reopen." />
    </Grid>
</Window>
